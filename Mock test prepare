
#include <stdio.h>

int main()
{
    int i, battery;
    int ready = 0, low = 0;
    int total = 0;

    for(i = 1; i <= 5; i++)
    {
        printf("Enter battery level of robot %d: ", i);
        scanf("%d", &battery);

        total = total + battery;

        if(battery >= 50)
        {
            printf("Robot Ready\n");
            ready++;
        }
        else
        {
            printf("Low Battery\n");
            low++;
        }
    }

    printf("\nTotal Ready Robots: %d", ready);
    printf("\nTotal Low Battery Robots: %d", low);
    printf("\nAverage Battery: %.2f", total / 5.0);

    return 0;
}
